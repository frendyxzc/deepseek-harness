# DeepSeek Harness local environment — copy to .env (gitignored) by
# scripts/setup-dsh/setup.sh, then fill real values. Never commit .env.
#
# Direct-API tests / demos (`pnpm run test:e2e`, `pnpm dsh`) read this.
DEEPSEEK_API_KEY=

# Feishu Bot creds consumed by the dsh-feishu* plugins installed via the
# `web` profile's cordis.patch.yml.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
