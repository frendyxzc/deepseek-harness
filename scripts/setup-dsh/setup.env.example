# One-key bootstrap config for scripts/setup-dsh/setup-one.sh.
#
# Copy this file to ~/.dsh/setup-dsh.env (chmod 600) and replace the values;
# keep it out of git: every key below is a credential or identifier.
#
# Rules:
#   - Values are exported as DSH_* env vars; setup.sh prefers them over its
#     interactive prompts, so a fully filled file never prompts.
#   - Required keys (noted below) fail loudly when missing/empty.
#   - Optional keys left empty behave exactly like leaving the prompt blank.
#   - Keep every value on one line; a literal newline makes config generation fail.
#
# Reference: the DSH_* variables are documented in scripts/setup-dsh/setup.sh
# (header block "Secret env vars").
#
# Upgrading an EXISTING deployment (after `git pull`) does not use this file:
# run `./scripts/setup-dsh/setup.sh --upgrade` — it migrates the profile patch,
# repairs a missing MemoryProxy binding, rebuilds, and NEVER regenerates
# DSH_PROXY_USER_KEY (see scripts/setup-dsh/README.md "Upgrading an existing
# deployment").

# --- Memory proxy user key (REQUIRED, unique per MemoryCore instance) ------
# Each MemoryCore instance generates its own key on first start. Do NOT copy
# a key from another machine — the agent will fail with "key not available".
# Leave empty to let setup.sh generate a random one (preferred for fresh
# installs); fill it only when you know the key from an existing instance.
DSH_PROXY_USER_KEY=""

# --- Feishu approval fallback chat id (optional; empty = no approval cards) --
DSH_FEISHU_FALLBACK_CHAT_ID="oc_..."

# --- <repo>/.env (each optional; empty lines are written as empty values) ----
DSH_DEEPSEEK_API_KEY="sk-..."
DSH_FEISHU_APP_ID="cli_..."
DSH_FEISHU_APP_SECRET="..."

# --- Multiple Feishu bots (REFERENCE; not read by setup.sh one-key) ---------
# One-key setup provisions a SINGLE bot `main` from DSH_FEISHU_APP_ID /
# DSH_FEISHU_APP_SECRET above. To run several bots, put each app's SECRET in
# <repo>/.env under its own name and reference it from the `feishu-bot`
# `credentials` list in the profile cordis.patch.yml (or your own patch layer).
# App IDs are NOT secret, so they stay literal in `bots[].appId` — never env —
# and are 1:1 with each bot's `id`. The names below are a convention for
# hand-written config, not keys setup.sh consumes.
#
#   <repo>/.env (secrets only; App IDs stay literal in bots):
#     FEISHU_APP_A_SECRET="..."
#     FEISHU_APP_B_SECRET="..."
#
#   profile cordis.patch.yml → feishu-bot config:
#     bots:
#       - id: bot-a
#         appId: cli_...          # literal App ID, 1:1 with its id
#         teamId: team-...        # optional; also editable in Settings > Plugins > IM
#         agentId: agt-...
#       - id: bot-b
#         appId: cli_...
#     credentials:
#       - id: bot-a
#         appSecretEnv: FEISHU_APP_A_SECRET
#       - id: bot-b
#         appSecretEnv: FEISHU_APP_B_SECRET

# --- Memory proxy upstream LLM (URL REQUIRED when memory stack is installed) -
DSH_PROXY_UPSTREAM_URL="https://host/compatible-mode/v1"
DSH_PROXY_UPSTREAM_API_KEY="sk-..."

# --- Memory panel kernel gateway bearer -------------------------------------
# The panel schema requires a NON-EMPTY api_key (InstanceRegistryError 500 on
# start otherwise), even though the local gateway never checks the Bearer
# value. Leave empty to fall back to DSH_PROXY_USER_KEY, then a fixed "local".
DSH_KERNEL_GATEWAY_API_KEY=""

# --- Memory core gateway LLM (API key REQUIRED when memory stack is installed)
DSH_TDAI_LLM_API_KEY="sk-..."
DSH_TDAI_LLM_BASE_URL="https://host/v1"
DSH_TDAI_LLM_MODEL="deepseek-v4-pro"

# --- Memory data dir (optional; default $HOME/.memory-tencentdb/memory-tdai) -
# DSH_MEMORY_DATA_DIR="/path/to/memory-data"

# --- GitLab MR integration (optional; empty bot username = skip entirely) ----
# Fill bot username to install the gitlab-mr skill + poller plugin (see
# gitlab-mr/README.md at the repo root). The token is appended to <repo>/.env.
DSH_GITLAB_BOT_USERNAME=""
DSH_GITLAB_API_BASE="https://gitlab.com/api/v4"
DSH_GITLAB_TOKEN="glpat-..."
